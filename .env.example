# ---------------------------------------------------------------------------
# Copy this file to `.env` in the repository root and fill in your own values.
# `.env` is gitignored — never commit real API keys.
# ---------------------------------------------------------------------------

# TabPFN / PriorLabs API key, used for the hosted TabPFN-2.5 models
# (src/TabPFN/model_factory.py reads TABPFN_API_KEY first, then PRIORLABS_API_KEY).
# Get a key from PriorLabs (https://priorlabs.ai) and paste it below.
TABPFN_API_KEY=
# PRIORLABS_API_KEY=

# Optional: HTTP timeout in seconds for TabPFN API calls. Must be in (0, 3600].
# Defaults to 300 when unset.
# TABPFN_API_TIMEOUT_SECONDS=300
